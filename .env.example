# =============================================================================
# PrePRO AI - Environment Variables (.env)
# =============================================================================
# In Spring Boot, configuration is primarily loaded via:
# src/main/resources/application.properties
#
# These environment variables can be set in your OS, in Render/Heroku environment
# settings, or passed to Docker when running the container.

# 1. Google Gemini AI API Key (Required for AI generation and Voice transcription)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Database Configuration
# Local default: Embedded H2 database file in ./data/prepro_prod_db
# Cloud (Render): PostgreSQL URL (e.g. postgresql://user:pass@host:5432/dbname)
DB_URL=jdbc:h2:file:./data/prepro_prod_db;AUTO_SERVER=TRUE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# 3. Server Port (Default 8082, or $PORT on Cloud hosts)
PORT=8082

# 4. Hibernate DDL Mode
DDL_AUTO=update
